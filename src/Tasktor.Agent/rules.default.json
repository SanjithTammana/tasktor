// Tasktor's shipped default rules (read-only in the install dir). Your own rules go in
// %LOCALAPPDATA%\Tasktor\rules.json: a rule there with the same "id" replaces one of these,
// and { "id": "...", "enabled": false } turns one off. Grammar: docs/rules.md.
{
  "$schema": "schemas/tasktor.rules-1.json",
  "schema_version": 1,
  "groups": {
    "agents": ["claude.exe", "codex.exe", "cursor.exe", "aider", "gemini", "opencode.exe", "agent-desktop.exe", "AutoHotkey*.exe"],
    "call_apps": ["ms-teams.exe", "Teams.exe", "Zoom.exe", "webexmta.exe", "CiscoCollabHost.exe", "Discord.exe", "slack.exe"],
    // Groups a guard may act on (U2 D-S4: opt-in per group, empty by default). Add exe globs to opt a group in.
    "meeting_guarded": [],
    "battery_guarded": []
  },
  "rules": [
    // A5 "disk-low" and "disk-filling" are built-in watches (max(10%, 15 GB) for 5 min; again after 5 GB more or 24 h;
    // learned fill rate). Turn one off in your rules.json with { "id": "disk-low", "enabled": false }.

    // A6 pressure alerts: RAM and commit on; CPU and disk saturation off (busy is often intended).
    { "id": "ram-pressure", "description": "A6: memory is low",
      "when": { "any": [ { "state": "low_memory" }, { "metric": "system.ram_used_pct", "above": 90 } ] },
      "for": "30s", "cooldown": "30m",
      "then": [ { "toast": "Memory is low: {offender} is using {offender_size} ({growth}){faster}", "severity": "warn",
                  "buttons": ["app.close", "open:core.apps", "snooze:1h"] } ] },
    { "id": "commit-pressure", "description": "A6: commit charge near its limit",
      "when": { "metric": "system.commit_pct", "above": 90 }, "for": "30s", "cooldown": "30m",
      "then": [ { "toast": "Memory commit is at {value}% of its limit: {offender} is using {offender_size}", "severity": "warn",
                  "buttons": ["app.close", "open:core.apps", "snooze:1h"] } ] },
    { "id": "cpu-saturation", "enabled": false, "description": "A6: CPU saturated",
      "when": { "metric": "system.cpu_pct", "above": 90 }, "for": "2m", "cooldown": "30m",
      "then": [ { "toast": "CPU at {value}% for 2 minutes", "buttons": ["open:core.apps", "snooze:1h"] } ] },
    { "id": "disk-saturation", "enabled": false, "description": "A6: disk saturated",
      "when": { "metric": "disk.active_pct", "above": 95 }, "for": "2m", "cooldown": "30m",
      "then": [ { "toast": "Disk {instance} is {value}% busy", "buttons": ["open:core.system", "snooze:1h"] } ] },

    // B2.2 silent job: quiet longer than this kind's learned normal (fallback 10 min, clamped 2–60 min). No End in a toast.
    { "id": "job-silent", "builtin": true, "description": "B2: a job went silent",
      "when": { "learned": { "stat": "silence", "key": "job.kind", "fallback": "10m", "clamp": ["2m", "60m"] } }, "cooldown": "30m",
      "then": [ { "toast": "{job} has been silent for {value}: {basis}", "severity": "warn",
                  "buttons": ["open:core.jobs", "job.log", "rule.its_fine"] } ] },
    // B2.3 stuck-busy: busy CPU but the progress file missed 2 × its heartbeat (else 10 min).
    { "id": "job-stuck", "builtin": true, "description": "B2: busy but no progress",
      "when": { "learned": { "stat": "heartbeat", "key": "job.kind", "fallback": "10m" } }, "cooldown": "30m",
      "then": [ { "toast": "{job} is busy but has not reported progress for {value}", "severity": "warn",
                  "buttons": ["open:core.jobs", "job.log", "rule.its_fine"] } ] },
    // B3.4 auto-restrain (off): lower a hogging job while the PC is contended; undo restores it.
    { "id": "auto-restrain", "enabled": false, "description": "B3.4: restrain hogging jobs",
      "when": { "learned": { "stat": "hogging", "key": "job.kind", "fallback": "1s" } },
      "then": [ { "set_priority": "below_normal" } ], "undo": true },

    // A8.2: unplugged under load (laptops only; warns, never acts).
    { "id": "unplugged-load", "description": "A8.2: unplugged while busy",
      "when": { "all": [ { "event": "power.unplugged" },
                         { "any": [ { "metric": "system.cpu_pct_2m", "above": 50 }, { "metric": "system.gpu_pct", "above": 50 }, { "metric": "jobs.running", "above": 0 } ] } ] },
      "then": [ { "toast": "Unplugged while {process} is busy: ~{time_left} left at this rate", "buttons": ["efficiency.set", "battery.settings"] } ] },

    // E2: one minute before a meeting, a Join toast (opens the link only when clicked).
    { "id": "meeting-join", "description": "E2: a meeting is about to start",
      "when": { "event": "meeting.soon" },
      "then": [ { "toast": "{title} starts at {start}", "buttons": ["url.open", "snooze:5m"] } ] },
    // E1: 24 h before a deadline (off).
    { "id": "deadline-24h", "enabled": false, "description": "E1: a deadline is a day away",
      "when": { "event": "deadline.soon" },
      "then": [ { "toast": "Due {when} tomorrow: {title}", "buttons": ["open:module.deadlines"] } ] },
    // I1 Q2: a session waiting for permission for 2 min, its window not in front (the wait and the window check are the
    // agent watch's, like B2.5); Show brings the window up.
    { "id": "agent-needs-permission", "description": "I1: an agent is waiting for your permission",
      "when": { "event": "agent.state" },
      "then": [ { "toast": "{agent} needs your permission in {folder}", "buttons": ["agent.show", "snooze:15m"] } ] },
    // I2 overlap guard (off): more than 2 agents busy at once for a minute. No automatic action.
    { "id": "overlap", "enabled": false, "description": "I2: many agents busy at once",
      "when": { "group": "agents", "busy_count_above": 2 }, "for": "1m", "cooldown": "1h",
      "then": [ { "toast": "{count} agents are busy at once", "buttons": ["agent.lower_newest", "open:module.agents"] }, { "badge": "{count}" } ] },

    // I13 / E11: during event mode and focus blocks, refits and the content worker wait.
    { "id": "event-mode-quiet", "description": "I13: event mode pauses background learning",
      "when": { "any": [ { "state": "event_mode" }, { "state": "focus_block" } ] },
      "then": [ { "pause": "refits" } ], "undo": true }
  ]
}
