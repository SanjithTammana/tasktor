<?xml version="1.0" encoding="utf-8"?>
<!-- U4 amended D-G13: the deep window. Windows Settings patterns: a left rail, a page title, rows separated by hairlines. -->
<Window
    x:Class="Tasktor.Flyout.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tasktor">

    <Grid x:Name="Root" Background="{ThemeResource TasktorMicaBrush}">
        <Grid.Resources>
            <!-- Retain the native template, footer, and high-contrast resources. -->
            <Style x:Key="TasktorDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="Background" Value="{ThemeResource TasktorMicaBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TasktorInkBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="WindowTitleBar" Height="48">
            <TitleBar.LeftHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
                    <!-- The approved board's Tasktor mark: three waves. -->
                    <Path Width="16" Height="16" StrokeThickness="1.3" Stroke="{ThemeResource TasktorInkBrush}"
                          Data="M1.5,5 C4,3 6,7 8,5 S12,3 14.5,5 M1.5,9 C4,7 6,11 8,9 S12,7 14.5,9 M1.5,13 C4,11 6,15 8,13 S12,11 14.5,13"
                          AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="Tasktor" VerticalAlignment="Center" Style="{StaticResource TasktorCaptionTextStyle}"
                               Foreground="{ThemeResource TasktorInkBrush}" />
                </StackPanel>
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <Button x:Name="FindButton" Width="480" Height="32" Padding="14,0,14,0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource TasktorSurfaceBrush}" Foreground="{ThemeResource TasktorInk2Brush}"
                        FontFamily="Segoe UI Variable Text" FontSize="14" CornerRadius="16"
                        AutomationProperties.Name="Find an app, a job or a page" Click="OnFind">
                    <Button.Resources>
                        <!-- The board's search field: card surface, secondary ink; raised on hover. -->
                        <StaticResource x:Key="ButtonBackground" ResourceKey="TasktorSurfaceBrush" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TasktorSurfaceRaisedBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TasktorSurfaceBrush" />
                        <StaticResource x:Key="ButtonForeground" ResourceKey="TasktorInk2Brush" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TasktorInkBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TasktorInk2Brush" />
                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CardStrokeColorDefaultBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CardStrokeColorDefaultBrush" />
                    </Button.Resources>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="16" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Find an app, a job or a page" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Style="{StaticResource TasktorBodyTextStyle}" />
                        <TextBlock x:Name="FindShortcut" Grid.Column="2" VerticalAlignment="Center"
                                   Style="{StaticResource TasktorCaptionTextStyle}" Foreground="{ThemeResource TasktorInk3Brush}" />
                    </Grid>
                </Button>
            </TitleBar.Content>
        </TitleBar>
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        OpenPaneLength="268" ExpandedModeThresholdWidth="1100" SelectionChanged="OnNavigate"
                        DisplayModeChanged="OnNavDisplayModeChanged"
                        FontFamily="Segoe UI Variable Text" FontSize="14"
                        Foreground="{ThemeResource TasktorInkBrush}">
            <NavigationView.Resources>
                <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="TasktorMicaBrush" />
                <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="TasktorSurfaceRaisedBrush" />
            </NavigationView.Resources>
            <ScrollViewer HorizontalContentAlignment="Stretch">
                <StackPanel Padding="28,8,40,40" HorizontalAlignment="Stretch">
                    <!-- The board's page heading: 8 above, 20 below (8 on tabbed pages, set in Draw). -->
                    <TextBlock x:Name="PageTitle" Margin="0,8,0,20" Style="{StaticResource TasktorTitleTextStyle}" Foreground="{ThemeResource TasktorInkBrush}" />
                    <StackPanel x:Name="PageContent" Spacing="24" />
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
