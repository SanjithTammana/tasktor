<?xml version="1.0" encoding="utf-8"?>
<!-- U4 amended D-G11: the shelf. One sentence whose nouns are controls, its unfolded actions, the inline confirm. -->
<Window
    x:Class="Tasktor.Flyout.ShelfWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tasktor">

    <Grid x:Name="Root" Background="{ThemeResource TasktorShelfBrush}" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The edge, grown: last hour of load, left = an hour ago. -->
        <Canvas x:Name="GrainCanvas" Grid.Row="0" Height="6" AutomationProperties.AccessibilityView="Raw">
            <Path x:Name="GrainPath" Stroke="{ThemeResource TasktorGlanceInk3Brush}" StrokeThickness="1" />
            <Path x:Name="HotPath" Stroke="{ThemeResource TasktorGlanceInkBrush}" StrokeThickness="1" />
        </Canvas>

        <StackPanel x:Name="Body" Grid.Row="1" Padding="48,24,48,24" Spacing="16">
            <Grid x:Name="HeadlineGrid" ColumnSpacing="24" SizeChanged="OnHeadlineSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Severity is a small shape beside the words, never a colour field (D-G14). -->
                <Path x:Name="SeverityMark" Grid.Column="0" Width="10" Height="10" Margin="0,14,0,0" VerticalAlignment="Top"
                      Stretch="Uniform" Visibility="Collapsed" />

                <RichTextBlock x:Name="Sentence" Grid.Column="1" HorizontalAlignment="Stretch" TextWrapping="Wrap"
                               FontFamily="Segoe UI Variable Display" FontSize="26" LineHeight="38" FontWeight="SemiLight"
                               Foreground="{ThemeResource TasktorGlanceInkBrush}" IsTextSelectionEnabled="False"
                               AutomationProperties.LiveSetting="Polite" />

                <HyperlinkButton x:Name="DeepLink" Grid.Column="2" VerticalAlignment="Top" Margin="0,6,0,0"
                                 Content="Everything Tasktor knows ›" Foreground="{ThemeResource TasktorGlanceInk2Brush}"
                                 Click="OnDeepLink" />
            </Grid>

            <ScrollViewer x:Name="ActionsScroll" Visibility="Collapsed" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ActionsRow" Orientation="Horizontal" Spacing="24" Visibility="Collapsed"
                            AutomationProperties.Name="Actions">
                    <TextBlock x:Name="ActionsLabel" VerticalAlignment="Center" Style="{StaticResource TasktorBodyTextStyle}"
                               Foreground="{ThemeResource TasktorGlanceInk3Brush}" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ConfirmScroll" Visibility="Collapsed" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ConfirmRow" Orientation="Horizontal" Spacing="16" Visibility="Collapsed">
                    <Button x:Name="KeepButton" Style="{StaticResource AccentButtonStyle}" MinHeight="36" Padding="18,7,18,7"
                            Content="Keep it" Click="OnKeep" />
                    <Button x:Name="ConfirmButton" MinHeight="36" Padding="18,7,18,7" Background="Transparent" BorderThickness="0"
                            Foreground="{ThemeResource TasktorGlanceInk2Brush}" Click="OnConfirm" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="NoticeText" Visibility="Collapsed" Style="{StaticResource TasktorBodyTextStyle}"
                       Foreground="{ThemeResource TasktorGlanceInk2Brush}" AutomationProperties.LiveSetting="Polite" />

            <!-- Asked once, only with more than one screen: where the shelf and command line open (ScreenSetting). -->
            <StackPanel x:Name="ScreenAsk" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                <TextBlock x:Name="ScreenAskText" VerticalAlignment="Center" Style="{StaticResource TasktorBodyTextStyle}"
                           Foreground="{ThemeResource TasktorGlanceInk2Brush}" />
                <Button x:Name="ScreenWorking" MinHeight="32" Padding="14,5,14,5" Click="OnScreenChosen" />
                <Button x:Name="ScreenMain" MinHeight="32" Padding="14,5,14,5" Click="OnScreenChosen" />
            </StackPanel>

            <!-- The hour as rows, alerts written on it, the lead row carried past "now" (dotted). -->
            <Canvas x:Name="Strip" Height="0" AutomationProperties.Name="The last hour" />
        </StackPanel>
    </Grid>
</Window>
