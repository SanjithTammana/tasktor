<?xml version="1.0" encoding="utf-8"?>
<!--
  U4 amended D-G14: Tasktor's shared theme. The colours, type ramp and spacing equal
  src/Tasktor.Hosts.Common/Theme/ThemeTokens.cs; ThemeParityTests keeps the two in step.
  Tasktor{Name}Color is the token; Tasktor{Name}Brush is what controls bind. The approved accent is pinned: the
  SystemAccentColor* keys below replace the user's Windows accent with Windows' default blue so every control
  (navigation, links, switches, check boxes) draws #60CDFF dark / #005FB8 light, as the approved boards do.
  High contrast uses system colours only.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="TasktorMicaColor">#FF202020</Color>
            <Color x:Key="TasktorShelfColor">#FF1C1C1C</Color>
            <Color x:Key="TasktorSurfaceColor">#FF2B2B2B</Color>
            <Color x:Key="TasktorSurfaceRaisedColor">#FF323232</Color>
            <Color x:Key="TasktorRuleColor">#FF3D3D3D</Color>
            <Color x:Key="TasktorInkColor">#FFFFFFFF</Color>
            <Color x:Key="TasktorInk2Color">#FFCFCFCF</Color>
            <Color x:Key="TasktorInk3Color">#FF9D9D9D</Color>
            <Color x:Key="TasktorGlanceInkColor">#FFFFFFFF</Color>
            <Color x:Key="TasktorGlanceInk2Color">#FFD6D6D6</Color>
            <Color x:Key="TasktorGlanceInk3Color">#FFABABAB</Color>
            <Color x:Key="TasktorAccentColor">#FF60CDFF</Color>
            <Color x:Key="TasktorOnAccentColor">#FF000000</Color>
            <Color x:Key="TasktorCautionColor">#FFFCE100</Color>
            <Color x:Key="TasktorCriticalColor">#FFFF99A4</Color>
            <Color x:Key="TasktorSuccessColor">#FF6CCB5F</Color>
            <Color x:Key="TasktorRecordingColor">#FFFF6A6A</Color>

            <SolidColorBrush x:Key="TasktorMicaBrush" Color="{StaticResource TasktorMicaColor}" />
            <SolidColorBrush x:Key="TasktorShelfBrush" Color="{StaticResource TasktorShelfColor}" />
            <SolidColorBrush x:Key="TasktorSurfaceBrush" Color="{StaticResource TasktorSurfaceColor}" />
            <SolidColorBrush x:Key="TasktorSurfaceRaisedBrush" Color="{StaticResource TasktorSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="TasktorRuleBrush" Color="{StaticResource TasktorRuleColor}" />
            <SolidColorBrush x:Key="TasktorInkBrush" Color="{StaticResource TasktorInkColor}" />
            <SolidColorBrush x:Key="TasktorInk2Brush" Color="{StaticResource TasktorInk2Color}" />
            <SolidColorBrush x:Key="TasktorInk3Brush" Color="{StaticResource TasktorInk3Color}" />
            <SolidColorBrush x:Key="TasktorGlanceInkBrush" Color="{StaticResource TasktorGlanceInkColor}" />
            <SolidColorBrush x:Key="TasktorGlanceInk2Brush" Color="{StaticResource TasktorGlanceInk2Color}" />
            <SolidColorBrush x:Key="TasktorGlanceInk3Brush" Color="{StaticResource TasktorGlanceInk3Color}" />
            <SolidColorBrush x:Key="TasktorAccentBrush" Color="{StaticResource TasktorAccentColor}" />
            <SolidColorBrush x:Key="TasktorOnAccentBrush" Color="{StaticResource TasktorOnAccentColor}" />
            <SolidColorBrush x:Key="TasktorCautionBrush" Color="{StaticResource TasktorCautionColor}" />
            <SolidColorBrush x:Key="TasktorCriticalBrush" Color="{StaticResource TasktorCriticalColor}" />
            <SolidColorBrush x:Key="TasktorSuccessBrush" Color="{StaticResource TasktorSuccessColor}" />
            <SolidColorBrush x:Key="TasktorRecordingBrush" Color="{StaticResource TasktorRecordingColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="TasktorMicaColor">#FFF3F3F3</Color>
            <Color x:Key="TasktorShelfColor">#FFF3F3F3</Color>
            <Color x:Key="TasktorSurfaceColor">#FFFBFBFB</Color>
            <Color x:Key="TasktorSurfaceRaisedColor">#FFF6F6F6</Color>
            <Color x:Key="TasktorRuleColor">#FFD6D6D6</Color>
            <Color x:Key="TasktorInkColor">#FF1A1A1A</Color>
            <Color x:Key="TasktorInk2Color">#FF5D5D5D</Color>
            <Color x:Key="TasktorInk3Color">#FF616161</Color>
            <Color x:Key="TasktorGlanceInkColor">#FF111111</Color>
            <Color x:Key="TasktorGlanceInk2Color">#FF3D3D3D</Color>
            <Color x:Key="TasktorGlanceInk3Color">#FF5A5A5A</Color>
            <Color x:Key="TasktorAccentColor">#FF005FB8</Color>
            <Color x:Key="TasktorOnAccentColor">#FFFFFFFF</Color>
            <Color x:Key="TasktorCautionColor">#FF9D5D00</Color>
            <Color x:Key="TasktorCriticalColor">#FFC42B1C</Color>
            <Color x:Key="TasktorSuccessColor">#FF0F7B0F</Color>
            <Color x:Key="TasktorRecordingColor">#FFC42B1C</Color>

            <SolidColorBrush x:Key="TasktorMicaBrush" Color="{StaticResource TasktorMicaColor}" />
            <SolidColorBrush x:Key="TasktorShelfBrush" Color="{StaticResource TasktorShelfColor}" />
            <SolidColorBrush x:Key="TasktorSurfaceBrush" Color="{StaticResource TasktorSurfaceColor}" />
            <SolidColorBrush x:Key="TasktorSurfaceRaisedBrush" Color="{StaticResource TasktorSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="TasktorRuleBrush" Color="{StaticResource TasktorRuleColor}" />
            <SolidColorBrush x:Key="TasktorInkBrush" Color="{StaticResource TasktorInkColor}" />
            <SolidColorBrush x:Key="TasktorInk2Brush" Color="{StaticResource TasktorInk2Color}" />
            <SolidColorBrush x:Key="TasktorInk3Brush" Color="{StaticResource TasktorInk3Color}" />
            <SolidColorBrush x:Key="TasktorGlanceInkBrush" Color="{StaticResource TasktorGlanceInkColor}" />
            <SolidColorBrush x:Key="TasktorGlanceInk2Brush" Color="{StaticResource TasktorGlanceInk2Color}" />
            <SolidColorBrush x:Key="TasktorGlanceInk3Brush" Color="{StaticResource TasktorGlanceInk3Color}" />
            <SolidColorBrush x:Key="TasktorAccentBrush" Color="{StaticResource TasktorAccentColor}" />
            <SolidColorBrush x:Key="TasktorOnAccentBrush" Color="{StaticResource TasktorOnAccentColor}" />
            <SolidColorBrush x:Key="TasktorCautionBrush" Color="{StaticResource TasktorCautionColor}" />
            <SolidColorBrush x:Key="TasktorCriticalBrush" Color="{StaticResource TasktorCriticalColor}" />
            <SolidColorBrush x:Key="TasktorSuccessBrush" Color="{StaticResource TasktorSuccessColor}" />
            <SolidColorBrush x:Key="TasktorRecordingBrush" Color="{StaticResource TasktorRecordingColor}" />
        </ResourceDictionary>

        <!-- High contrast: system colours only; severity is carried by the mark's shape, not its colour. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="TasktorMicaBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TasktorShelfBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TasktorSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TasktorSurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TasktorRuleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TasktorInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TasktorInk2Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TasktorInk3Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TasktorGlanceInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TasktorGlanceInk2Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TasktorGlanceInk3Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TasktorAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="TasktorOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TasktorCautionBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TasktorCriticalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TasktorSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TasktorRecordingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- The approved accent: Windows' default blue palette, used instead of the user's Windows accent. -->
    <Color x:Key="SystemAccentColor">#FF0078D4</Color>
    <Color x:Key="SystemAccentColorLight1">#FF0093F9</Color>
    <Color x:Key="SystemAccentColorLight2">#FF60CDFF</Color>
    <Color x:Key="SystemAccentColorLight3">#FF99EBFF</Color>
    <Color x:Key="SystemAccentColorDark1">#FF005FB8</Color>
    <Color x:Key="SystemAccentColorDark2">#FF003E92</Color>
    <Color x:Key="SystemAccentColorDark3">#FF001A68</Color>

    <!-- Spacing (4 px grid). The shelf pads 24 vertical, 48 horizontal. -->
    <x:Double x:Key="TasktorSpace4">4</x:Double>
    <x:Double x:Key="TasktorSpace8">8</x:Double>
    <x:Double x:Key="TasktorSpace12">12</x:Double>
    <x:Double x:Key="TasktorSpace16">16</x:Double>
    <x:Double x:Key="TasktorSpace24">24</x:Double>
    <x:Double x:Key="TasktorSpace32">32</x:Double>
    <x:Double x:Key="TasktorSpace48">48</x:Double>

    <!-- Type ramp. -->
    <Style x:Key="TasktorCommandTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="LineHeight" Value="44" />
        <Setter Property="FontWeight" Value="SemiLight" />
    </Style>
    <Style x:Key="TasktorSentenceTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="LineHeight" Value="38" />
        <Setter Property="FontWeight" Value="SemiLight" />
    </Style>
    <Style x:Key="TasktorTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TasktorSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TasktorBodyStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TasktorBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="TasktorCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
</ResourceDictionary>
