{
  "template": {
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
    "body": [
      {
        "type": "ColumnSet",
        "columns": [
          {
            "type": "Column",
            "width": "stretch",
            "items": [
              {
                "type": "TextBlock",
                "text": "${title}",
                "wrap": true,
                "weight": "Bolder",
                "isSubtle": "${stale}"
              }
            ]
          },
          {
            "type": "Column",
            "width": "auto",
            "$when": "${severity.show}",
            "items": [
              {
                "type": "TextBlock",
                "text": "${severity.icon} ${severity.word}",
                "wrap": true,
                "color": "${severity.color}"
              }
            ]
          }
        ]
      },
      {
        "type": "TextBlock",
        "text": "${as_of}",
        "wrap": true,
        "isSubtle": true,
        "size": "Small",
        "$when": "${stale}"
      },
      {
        "type": "Container",
        "items": [
          {
            "type": "TextBlock",
            "text": "${b0.label}",
            "wrap": true,
            "isSubtle": true,
            "size": "Small"
          },
          {
            "type": "TextBlock",
            "text": "${b0.value} ${b0.trend}",
            "wrap": true,
            "weight": "Bolder",
            "isSubtle": "${stale}",
            "size": "Large"
          },
          {
            "type": "TextBlock",
            "text": "${b0.severity}",
            "wrap": true,
            "size": "Small",
            "color": "Default",
            "$when": "${b0.severity != \u0027\u0027}"
          }
        ]
      },
      {
        "type": "Container",
        "items": [
          {
            "type": "TextBlock",
            "text": "${b1.label}",
            "wrap": true,
            "isSubtle": true,
            "size": "Small"
          },
          {
            "type": "TextBlock",
            "text": "${b1.value} ${b1.trend}",
            "wrap": true,
            "weight": "Bolder",
            "isSubtle": "${stale}",
            "size": "Large"
          },
          {
            "type": "TextBlock",
            "text": "${b1.severity}",
            "wrap": true,
            "size": "Small",
            "color": "Default",
            "$when": "${b1.severity != \u0027\u0027}"
          }
        ]
      }
    ],
    "selectAction": {
      "type": "Action.OpenUrl",
      "url": "tasktor://open?card=core.system"
    }
  },
  "data": {
    "title": "System",
    "severity": {
      "icon": "\u26A0",
      "word": "Warning",
      "show": true,
      "color": "Warning"
    },
    "stale": false,
    "as_of": "",
    "b0": {
      "severity": "",
      "label": "CPU",
      "value": "34 %",
      "trend": "\u2191"
    },
    "b1": {
      "severity": "",
      "label": "RAM",
      "value": "71 %",
      "trend": ""
    }
  }
}
